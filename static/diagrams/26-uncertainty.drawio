<mxfile host="Electron" type="device" version="24.7.17" agent="Kainos Software Limited" modified="2026-09-11T15:45:00Z">
  <diagram id="26-uncertainty" name="26 uncertainty">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="946" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2.5;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2.5;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2.5;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;Uncertainty, from scoping to publication&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1720" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;All analysis is uncertain. The question is never whether uncertainty exists, but whether you identified it, managed it, and told the reader in a way they can act on.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;Two kinds, and most analysis has both&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Direct uncertainty&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Uncertainty about an estimate that can be measured or quantified, and communicated in absolute terms: a standard error, a confidence or credible interval, statistical significance.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="144" width="852" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Indirect uncertainty&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Uncertainty about the underlying quality of knowledge surrounding an estimate. Not directly measured but inferred. Usually communicated as caveats, or on a qualitative or ordered scale.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="908" y="144" width="852" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Reporting only the first, because it is the one with a number attached, is a common and misleading omission.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="226" width="1720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;And four moments, in the order you meet them&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1720" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Engagement and scoping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#003087&quot;&gt;&lt;b&gt;Agree how much of it the decision can carry&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Agree with your commissioner &lt;b&gt;how certain the answer needs to be&lt;/b&gt;, and record the levels of quality and certainty required. GovS 010 5.2.&lt;br&gt;&lt;br&gt;An analysis with no agreed margin of error has no threshold to be tested against, and a commissioner who was never asked has no grounds for saying an answer is not good enough.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="276" width="418" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#003087&quot;&gt;&lt;b&gt;Mine for it, while you can still design around it&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Mine the planned analysis systematically&lt;/b&gt; for possible sources and types of uncertainty, to catch any large enough to breach the acceptable margin of error. AQuA Book 7.4.&lt;br&gt;&lt;br&gt;Identify the sources and consider their impacts. Analyse it &lt;b&gt;at the level the decision requires, and no further&lt;/b&gt;. Develop options for managing it, and take control and mitigation actions. GovS 010 6.5.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="474" y="276" width="418" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Analysis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#003087&quot;&gt;&lt;b&gt;Record it, and test what rests on it&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Record each material assumption with its rationale, the &lt;b&gt;impact if wrong&lt;/b&gt;, whether sensitivity was tested and who agreed it.&lt;br&gt;&lt;br&gt;Test the sensitivity of your key assumptions, planned at design rather than retrofitted. At Level 3 Comprehensive this is required. At Level 3 uncertainty is quantified where the method allows.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="908" y="276" width="418" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Delivery and sign-off&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#003087&quot;&gt;&lt;b&gt;Say it in a way the reader can act on&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Be &lt;b&gt;quantitative where possible&lt;/b&gt; and balanced, avoiding unwarranted confidence in a particular option. GovS 010 6.5.&lt;br&gt;&lt;br&gt;Be transparent about it, be specific about what exactly is uncertain and why, use plain language, and &lt;b&gt;show it in the visualisations, data tables and datasets&lt;/b&gt;. Confining it to a quality and methodology annex is not enough.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1342" y="276" width="418" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;What to record for each material assumption&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="1720" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b style=&quot;font-size:12px&quot;&gt;The assumption&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stated plainly, so someone else can judge it&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="512" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b style=&quot;font-size:12px&quot;&gt;Rationale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Why it is reasonable&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="386" y="512" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b style=&quot;font-size:12px&quot;&gt;Impact if wrong&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Direction and rough scale. The field people skip and the one that matters&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="732" y="512" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b style=&quot;font-size:12px&quot;&gt;Sensitivity tested&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Yes or no. At Level 3, tested where material&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1078" y="512" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b style=&quot;font-size:12px&quot;&gt;Agreed with&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Who accepted it, and when&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1424" y="512" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="606" width="848" height="112" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;Uncertainty is not a hedge&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="618" width="808" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Presented well, a range tells the commissioner whether the analysis is decisive. If the decision would be the same at both ends of the plausible range, say so and they can proceed with confidence. If it would differ, that is often the most useful finding you have, and it may be worth reducing the uncertainty before deciding. &lt;b&gt;Quantified uncertainty makes analysis more useful, not less.&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="642" width="808" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="912" y="606" width="848" height="112" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;State limitations in terms of use, not method&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="932" y="618" width="808" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Rather than &quot;the data has incomplete coverage for two months&quot;, write &quot;these figures understate activity in July and August, so they should not be used to compare quarters&quot;. The most useful sentence in any limitations section is usually &lt;b&gt;&quot;this analysis should not be used to...&quot;&lt;/b&gt;, followed by the specific misuse it cannot support.&lt;/span&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="932" y="642" width="808" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="860" height="142" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;How to read this&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="52" y="756" width="836" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="778" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;span style=&quot;font-size:11px&quot;&gt;Dark blue card: a kind of uncertainty&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="777" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="804" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;span style=&quot;font-size:11px&quot;&gt;Blue card and blue arrow: a moment in the lifecycle, read left to right&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="803" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="830" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;span style=&quot;font-size:11px&quot;&gt;Green card: a field of the assumption record&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="829" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="856" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="&lt;span style=&quot;font-size:11px&quot;&gt;Grey box: something that holds throughout&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="855" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;span style=&quot;font-size:12px&quot;&gt;The first moment is the one most often skipped. GovS 010 asks for the levels of quality and certainty required to be agreed and recorded at scoping; the AQuA Book asks analysts at design to mine for uncertainty large enough to breach &quot;the acceptable margin of error&quot;, which only means something if somebody has said what that margin is. Neither is about measuring uncertainty. They are about agreeing how much of it the decision can carry, while there is still time to design for it. Every card here is written out in the text description below the picture.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="912" y="756" width="848" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Producing Quality Analysis  ·  NHS Business Services Authority&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="902" width="1720" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
