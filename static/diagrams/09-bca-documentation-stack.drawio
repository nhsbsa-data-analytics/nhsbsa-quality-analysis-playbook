  <diagram id="09-bca-documentation-stack" name="09-bca-documentation-stack">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="460" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;Who owns the Business Critical documentation&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1520" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;The four roles, and what each one owns in the stack of eleven documents&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;DOES THE WORK&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;The analyst&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Writes the scope, the specification, the model and both guides.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=10;spacingRight=10;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="136" width="359" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;ALSO THE LEAD ASSURER&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;The critical friend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Reviews it, and signs the assurance review and the sign-off.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=10;spacingRight=10;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="427" y="136" width="359" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;OWNS THE DECISION&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;The commissioner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Agrees the assurance level decision sheet with the analyst.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=10;spacingRight=10;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="814" y="136" width="359" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;APPROVES IT&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;The Analysis Senior Responsible Officer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Confirms it is fit for its intended use, last of all.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=10;spacingRight=10;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1201" y="136" width="359" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Most of the eleven documents are the analyst's, and assurance comes at the end.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="274" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1520" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;SIGN-OFF IS NOT THE END OF IT&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="64" y="344" width="1472" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:12px;color:#231F20&quot;&gt;Quality assurance carries on after approval, and a material change sends the stack back for review.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="64" y="370" width="1472" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
