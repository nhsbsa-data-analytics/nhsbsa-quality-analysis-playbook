        <mxCell id="n8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Public visibility and reach&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="322" y="180" width="266" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Reputation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="604" y="180" width="266" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;1 low, informational&amp;nbsp; · &amp;nbsp;2 moderate, operational&amp;nbsp; · &amp;nbsp;3 high, organisational&amp;nbsp; · &amp;nbsp;&lt;b&gt;4 very high, business critical&lt;/b&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="222" width="840" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Any one dimension at 4 is Business Critical.&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;It does not need two, and it carries the analysis to Level 4 whatever the likelihood. Assurance Journey, 17 September 2026, section 5.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="840" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b style=&quot;font-size:13px;color:#0072C6&quot;&gt;Step 2&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#003087&quot;&gt;&lt;b&gt;Score the likelihood of an error, and take the highest&lt;/b&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
