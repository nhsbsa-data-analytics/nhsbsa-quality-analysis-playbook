        </mxCell>
        <mxCell id="n21" value="&lt;b style=&quot;font-size:13px;color:#0072C6&quot;&gt;Step 3&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#003087&quot;&gt;&lt;b&gt;Read the level off the matrix&lt;/b&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
