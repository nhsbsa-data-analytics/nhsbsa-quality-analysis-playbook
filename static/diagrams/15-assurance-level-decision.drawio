        </mxCell>
        <mxCell id="n19" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;1 low risk of error&amp;nbsp; · &amp;nbsp;2 moderate&amp;nbsp; · &amp;nbsp;3 high&amp;nbsp; · &amp;nbsp;4 very high&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="920" y="222" width="840" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;span style=&quot;font-size:11px&quot;&gt;Likelihood never lowers a Business Critical result. It decides the level for everything else, and a low likelihood with a high impact still lands at Level 1 only where the impact is moderate or below.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
