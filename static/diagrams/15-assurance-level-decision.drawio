        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;Score the impact, score the likelihood, read the matrix. Four steps, from NHSBSA’s own decision sheet of 10 September 2026. Nothing here is a second instrument: it is that sheet, drawn.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:13px;color:#0072C6&quot;&gt;Step 1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#003087&quot;&gt;&lt;b&gt;Score the impact of an error, and take the highest&lt;/b&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
