        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Every cell in the top row is Level 4, which is the same rule as Step 1: a 4 on any impact dimension is Business Critical, whatever the likelihood.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="104" y="692" width="846" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;b style=&quot;font-size:13px;color:#0072C6&quot;&gt;Step 4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#003087&quot;&gt;&lt;b&gt;Do what the level asks&lt;/b&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1000" y="324" width="760" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 1 Standard&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;Routine work whose consequences are contained.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Requirements validated, sources and assumptions clear, calculations checked, results sense checked, outputs clear and accessible.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEFE4;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="352" width="760" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 2 Enhanced&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;Work that matters operationally, or is harder to get right.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Level 1 and: accountabilities named, methodology appropriate, documentation and audit trail, data quality understood, assumptions evidenced, code scrutinised, validated with stakeholders, sensitivity tested, triangulated.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="424" width="760" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 3 Comprehensive&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;Work that carries organisational consequence.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Levels 1 and 2 and: change control, ethical risks considered, knowledge shared, documentation reviewed in detail, usability tested, automated checks, scenario testing, independent peer review.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D0;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="526" width="760" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 4 BCA&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;Business Critical. Consequences are large and external.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Levels 1 to 3 and: formal audit, external review, documentation scrutinised, structural and conceptual assumptions scrutinised, further scenario testing. The Business Critical documentation stack applies.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="628" width="760" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="1720" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;What does not, by itself, make analysis Business Critical&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="760" width="1676" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:12px&quot;&gt;“Publication status, Board consideration, Official Statistics designation, media interest, national visibility, FOI disclosure, ministerial interest or parliamentary scrutiny do not by themselves justify a Level 4 score.”&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#425563&quot;&gt;Assurance Journey, 17 September 2026, section 5.&lt;/span&gt;&lt;br&gt;Official statistics are assured under the Code of Practice whether or not they are Business Critical. The two are different questions, and a publication answers both separately.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="784" width="1676" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="884" width="1720" height="194" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;Where NHSBSA has placed its own work&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;From the worked examples annex to the decision sheet, 10 September 2026, which the workbook marks “to be developed”.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="896" width="1676" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 1 Standard&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEFE4;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="922" width="168" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="&lt;span style=&quot;font-size:12px&quot;&gt;Exploratory analysis&amp;nbsp; · &amp;nbsp;Internal data investigation&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="242" y="926" width="1496" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 2 Enhanced&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="952" width="168" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;span style=&quot;font-size:12px&quot;&gt;Monthly operational dashboard&amp;nbsp; · &amp;nbsp;Team workforce planning&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="242" y="956" width="1496" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 3 Comprehensive&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D0;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="982" width="168" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="&lt;span style=&quot;font-size:12px&quot;&gt;Prescription Cost Analysis&amp;nbsp; · &amp;nbsp;Dental Statistics&amp;nbsp; · &amp;nbsp;FOI response&amp;nbsp; · &amp;nbsp;Board report&amp;nbsp; · &amp;nbsp;Ministerial briefing&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="242" y="986" width="1496" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="&lt;b style=&quot;font-size:12px&quot;&gt;Level 4 BCA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="1012" width="168" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="&lt;span style=&quot;font-size:12px&quot;&gt;Funding allocation formula&amp;nbsp; · &amp;nbsp;Eligibility model&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="242" y="1016" width="1496" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Board reports, FOI responses and ministerial briefings sit at Level 3 here, which is the exclusion above applied: visibility raises the assurance, and on its own it does not make the analysis Business Critical.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="1046" width="1676" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Producing Quality Analysis  ·  NHS Business Services Authority&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1178" width="1720" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
