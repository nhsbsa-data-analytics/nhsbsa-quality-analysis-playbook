        <mxCell id="n4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;PHASE 2&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Plan what Level 4 BCA asks for, and the documentation it needs.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=14;spacingRight=14;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
