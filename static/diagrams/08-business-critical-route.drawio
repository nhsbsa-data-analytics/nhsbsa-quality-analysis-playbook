        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;The same five phases, and what each one asks for when the work is Business Critical&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:10px;color:#003087;letter-spacing:0.8px&quot;&gt;PHASE 1&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:15px;color:#003087&quot;&gt;Engagement and scoping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Decide it, name who is accountable, and get it on the register.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=14;spacingRight=14;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
