        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;Green card, and the green arrow: where it goes if you cannot agree&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
