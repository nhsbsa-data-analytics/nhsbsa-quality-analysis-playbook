        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;How a lesson gets back to the start&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
