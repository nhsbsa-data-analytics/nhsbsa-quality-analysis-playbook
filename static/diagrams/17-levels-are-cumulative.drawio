        <mxCell id="n45" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;A Level is not a tier&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="894" width="808" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;span style=&quot;font-size:12px&quot;&gt;A tier is one band of activity. A Level includes every level below it as well as its own. Reading Tier 3 as Level 3 means doing the third band and none of the two beneath it, which is why this playbook uses Level throughout. Section 5 sets the level; this is what it buys you.&lt;/span&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="918" width="808" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="912" y="882" width="848" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;Why the Level 4 BCA block is short&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="932" y="894" width="808" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Everything that is true only of Business Critical work, including the register entry, the quality assurance appraisal and the documentation stack, is in section 8 rather than repeated here. If you scored 4 on any impact dimension, do the Level 3 block and then go there.&lt;/span&gt;&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="932" y="918" width="808" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1008" width="860" height="168" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;How to read this&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="52" y="1016" width="836" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="1038" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="&lt;span style=&quot;font-size:11px&quot;&gt;The outer box contains the inner ones: its checks are additional, not instead of&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1037" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="1064" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;span style=&quot;font-size:11px&quot;&gt;Level 1 Standard, innermost: seven checks start here&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1063" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="1090" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="&lt;span style=&quot;font-size:11px&quot;&gt;Level 2 Enhanced: nine more, and separation from the work&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1089" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="1116" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;span style=&quot;font-size:11px&quot;&gt;Level 3 Comprehensive: eight more, separation from the team, published statement&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1115" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="52" y="1142" width="18" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="&lt;span style=&quot;font-size:11px&quot;&gt;Level 4 BCA: five more, Business Critical work only&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1141" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;span style=&quot;font-size:12px&quot;&gt;Twenty-nine checks in all: seven first required at Level 1, nine more at Level 2, eight more at Level 3 and five more at Level 4 BCA. They are NHSBSA's own, from the assurance level decision sheet, and section 6 says what each one means in practice. Your quality assurance log records which you did, when, and what you found. Every check named in the picture is listed in the text description below it.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="912" y="1016" width="848" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Producing Quality Analysis  ·  NHS Business Services Authority&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="1720" height="20" as="geometry" />
        </mxCell>
      </root>
