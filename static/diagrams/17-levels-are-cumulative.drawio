        <mxCell id="n12" value="&lt;b style=&quot;font-size:16px;color:#005EB8&quot;&gt;Level 3 Comprehensive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Contains Levels 1 and 2 and adds eight checks. What the step up buys is separation from the team, and published transparency.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
