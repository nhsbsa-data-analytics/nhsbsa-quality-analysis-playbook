        <mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#007F3B;strokeWidth=2;dashed=1;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="286" y="852.0" />
              <mxPoint x="286" y="292.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;An Analysis Senior Responsible Officer’s journey through this playbook&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1720" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;Seven stops. This role is assigned for Business Critical analysis and models, and the AQuA Book calls it the approver. You may also be the commissioner.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;Where you are&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="226" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;Section&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="306" y="120" width="210" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;What you do there&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="532" y="120" width="680" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;What you leave behind&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1228" y="120" width="532" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;span style=&quot;font-size:12px&quot;&gt;You have been named for a piece of Business Critical analysis.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="152" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b style=&quot;font-size:17px&quot;&gt;§8&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Business Critical analysis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="152" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;span style=&quot;font-size:12px&quot;&gt;§8 is the whole route in nine steps. &lt;b&gt;Your appointment and the register entry start at scoping&lt;/b&gt;, not once the work is designed and someone notices a signature is needed.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="152" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:12px&quot;&gt;The register entry, with your name against it.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="152" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;span style=&quot;font-size:12px&quot;&gt;What am I taking responsibility for?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b style=&quot;font-size:17px&quot;&gt;§3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Roles and responsibilities&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="250" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;span style=&quot;font-size:12px&quot;&gt;The risks across the lifecycle, and confirming the work is &lt;b&gt;suitable for its intended use before it is used&lt;/b&gt;. You need to be senior enough to carry that.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="250" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;span style=&quot;font-size:12px&quot;&gt;Nothing recorded yet. What you have is the scope of what you are accountable for, which is worth settling before the first thing arrives to sign.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="250" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;span style=&quot;font-size:12px&quot;&gt;Is the work set up to succeed?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="348" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b style=&quot;font-size:17px&quot;&gt;§4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The analytical lifecycle, phase 1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="348" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;span style=&quot;font-size:12px&quot;&gt;Note the work, and confirm resources and plans are in place for the assurance to happen. Confirm the Business Critical status and the register entry.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="348" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;span style=&quot;font-size:12px&quot;&gt;Confirmed resources, and the register entry checked rather than assumed.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="348" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Level 4 BCA adds to Level 3 rather than replacing it:&lt;/b&gt; formal audits, external review, additional scrutiny of the documentation, scrutiny of the structural and conceptual assumptions, and additional scenario testing. Everything at Levels 1 to 3 still applies underneath.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="446" width="1720" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;span style=&quot;font-size:12px&quot;&gt;Has the design been governed?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="516" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b style=&quot;font-size:17px&quot;&gt;§4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The analytical lifecycle, phase 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="516" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;span style=&quot;font-size:12px&quot;&gt;Where the work is Business Critical, confirm design governance has been followed before the analysis starts.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="516" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;span style=&quot;font-size:12px&quot;&gt;Design governance confirmed, and recorded as confirmed.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="516" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;span style=&quot;font-size:12px&quot;&gt;The work is running.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="614" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b style=&quot;font-size:17px&quot;&gt;§4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The analytical lifecycle, phase 3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="614" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;span style=&quot;font-size:12px&quot;&gt;Stay aware of progress, and make sure you are available to approve at delivery.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="614" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;span style=&quot;font-size:12px&quot;&gt;Nothing recorded here. What you leave is your availability in the schedule.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="614" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;span style=&quot;font-size:12px&quot;&gt;Approving it.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="712" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b style=&quot;font-size:17px&quot;&gt;§6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Doing the work, phase 4&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="712" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;span style=&quot;font-size:12px&quot;&gt;Review the assurance evidence. Confirm the work meets the design requirements, is of sufficient quality and is proportionately documented, then approve it as fit for its intended use. &lt;b&gt;You shall review the evidence before signing off.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="712" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;span style=&quot;font-size:12px&quot;&gt;Your approval, recorded with what you confirmed. At Level 4 BCA the Lead Assurer signs off first, then you.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="712" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;span style=&quot;font-size:12px&quot;&gt;Is the designation still right?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b style=&quot;font-size:17px&quot;&gt;§11&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Review and continuous improvement&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="810" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;span style=&quot;font-size:12px&quot;&gt;Revalidating the designation is yours. Level 3 and Level 4 work is reviewed annually and &lt;b&gt;before any reuse for a new purpose&lt;/b&gt;, because a new purpose is the change most likely to invalidate the assumptions the original was built on.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="810" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;span style=&quot;font-size:12px&quot;&gt;The revalidated designation, and the register updated.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="810" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="&lt;span style=&quot;font-size:12px;color:#007F3B&quot;&gt;The dashed line is the loop. What review finds is what the next revalidation starts from, which is what GovS 010 6.10 asks for: lessons captured through the cycle, evaluated, and acted on at the start of the next piece of work.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="912" width="1720" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;Open alongside, at any stop.&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;§5&lt;/b&gt; for how the designation was reached, which is the same scoring that set the level. &lt;b&gt;§8&lt;/b&gt; for everything that is true only of Business Critical work. &lt;b&gt;§13&lt;/b&gt; if you are not sure which of the senior titles you have been asked to hold.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="942" width="1720" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1036" width="1060" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;You will meet other titles for this role&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="1050" width="1016" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;span style=&quot;font-size:12px&quot;&gt;This playbook calls it the &lt;b&gt;Analysis Senior Responsible Officer&lt;/b&gt; throughout. The Business Critical documentation calls it the &lt;b&gt;Model Senior Responsible Officer&lt;/b&gt;, the draft Analytical Governance and Quality Assurance Policy calls it the &lt;b&gt;Senior Responsible Owner&lt;/b&gt;, and the AQuA Book calls it the &lt;b&gt;approver&lt;/b&gt;. They are the same role. If a document in front of you uses one of those titles, read it as this one.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="1076" width="1016" height="98" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1036" width="620" height="142" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;How to read this&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1152" y="1044" width="596" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
