        <mxCell id="n55" value="&lt;span style=&quot;font-size:11px&quot;&gt;What you leave behind: the artefact that evidences the stop&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
