        </mxCell>
        <mxCell id="n51" value="&lt;span style=&quot;font-size:11px&quot;&gt;Where you are: the question in your head when you open the playbook&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1065" width="570" height="18" as="geometry" />
