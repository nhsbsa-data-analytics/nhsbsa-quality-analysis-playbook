  <diagram id="05-assurance-level-matrix" name="05-assurance-level-matrix" description="A grid with likelihood across the top, from 1 low to 4 very high, and impact down the side, from 4 very high at the top to 1 low at the bottom. Where cells side by side give the same level they are drawn as one. Impact 4 is Level 4 BCA at every likelihood. Impact 3 is Level 1 Standard at likelihood 1, Level 2 Enhanced at 2, and Level 3 Comprehensive at 3 and 4. Impact 2 is Level 1 Standard at likelihood 1, Level 2 Enhanced at 2 and 3, and Level 3 Comprehensive at 4. Impact 1 is Level 1 Standard at likelihood 1 to 3, and Level 2 Enhanced at 4.">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="680" pageHeight="416" math="0" shadow="0" background="#FFFFFF">
