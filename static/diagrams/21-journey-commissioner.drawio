  <diagram id="a-commissioner’s-journey-through-this-playbook" name="A commissioner’s journey through this playbook">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1242" math="0" shadow="0" background="#FFFFFF">
