        <mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n21" target="n25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005EB8;strokeWidth=2;dashed=0;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#007F3B;strokeWidth=2;dashed=1;endArrow=classic;startArrow=none;fontFamily=Arial;fontSize=10;fontColor=#425563;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="286" y="852.0" />
              <mxPoint x="286" y="292.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;A critical friend’s journey through this playbook&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1720" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;Seven stops. Critical friend and analytical assurer are two names for this one role, so everything the standards say about the analytical assurer applies to you.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;Where you are&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="226" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;Section&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="306" y="120" width="210" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;What you do there&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="532" y="120" width="680" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b style=&quot;font-size:12px;color:#425563&quot;&gt;What you leave behind&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1228" y="120" width="532" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;span style=&quot;font-size:12px&quot;&gt;You have been asked to be a critical friend.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="152" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b style=&quot;font-size:17px&quot;&gt;§3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Roles and responsibilities&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="152" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;span style=&quot;font-size:12px&quot;&gt;You give independent advice on this one assignment. &lt;b&gt;You are not delivering the analysis&lt;/b&gt;, and you and the analyst shall be separate from one another in all cases.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="152" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:12px&quot;&gt;Nothing recorded yet. What you have is a clear answer on whether you are independent enough to take this on.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="152" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;span style=&quot;font-size:12px&quot;&gt;How far from the work do I have to sit?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b style=&quot;font-size:17px&quot;&gt;§3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Independence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="250" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;span style=&quot;font-size:12px&quot;&gt;The degree of separation follows the level: a colleague within the team at Level 1, someone with no hand in the work at Level 2, an assurer from outside the delivering team at Level 3, a Lead Assurer with external review at Level 4 BCA.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="250" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;span style=&quot;font-size:12px&quot;&gt;Your name on the design and plan, recorded &lt;b&gt;before the work starts&lt;/b&gt; rather than found after it finishes.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="250" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;span style=&quot;font-size:12px&quot;&gt;A reviewer found afterwards reviews what was produced. A reviewer named beforehand shapes what gets produced, which is considerably more useful and usually cheaper. That is why the stop above comes second and not seventh.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="348" width="1720" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;span style=&quot;font-size:12px&quot;&gt;What am I actually reviewing?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="418" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b style=&quot;font-size:17px&quot;&gt;§6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Doing the work, phase 2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="418" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;span style=&quot;font-size:12px&quot;&gt;Review the plan, confirm the approach answers the question, confirm the assurance planned is at the right level, and &lt;b&gt;plan your own time for it&lt;/b&gt;. An assurance plan with no time in the schedule is a statement of intent.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="418" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;span style=&quot;font-size:12px&quot;&gt;A reviewed assurance plan, and your time in the schedule.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="418" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;span style=&quot;font-size:12px&quot;&gt;What checks am I doing?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="516" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b style=&quot;font-size:17px&quot;&gt;§6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The checks, by level&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="516" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;span style=&quot;font-size:12px&quot;&gt;Read the block for the level and everything inside it. At Level 2 that includes independently reproducing the calculations from source; at Level 3 it includes reading the documentation as a document, not only the numbers.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="516" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;span style=&quot;font-size:12px&quot;&gt;Entries in the quality assurance log against your name, with what you found rather than only that you looked.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="516" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;span style=&quot;font-size:12px&quot;&gt;I have found something.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="614" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b style=&quot;font-size:17px&quot;&gt;§6&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Doing the work, phase 3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="614" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;span style=&quot;font-size:12px&quot;&gt;You &lt;b&gt;shall&lt;/b&gt; review the assurance the analyst has done and report errors and improvements back. Reporting them is yours; acting on them is the analyst’s.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="614" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;span style=&quot;font-size:12px&quot;&gt;Findings recorded, and the analyst’s response to each one.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="614" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;span style=&quot;font-size:12px&quot;&gt;Has the uncertainty been handled honestly?&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="712" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b style=&quot;font-size:17px&quot;&gt;§7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Uncertainty&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="712" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;span style=&quot;font-size:12px&quot;&gt;Check the assumptions are traceable to a source, a precedent or a stated expert judgement; that limitations are in the output rather than only in an annex; and that uncertainty is quantified where the method allows.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="712" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;span style=&quot;font-size:12px&quot;&gt;A recorded view on whether the uncertainty is handled adequately.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="712" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;span style=&quot;font-size:12px&quot;&gt;Saying what I assured.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="226" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b style=&quot;font-size:17px&quot;&gt;§9&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Communicating analysis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="306" y="810" width="210" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;span style=&quot;font-size:12px&quot;&gt;Communicate the assurance state: that the work was appropriately scoped, executed, validated, verified and documented, and that uncertainty is handled adequately. That is what the statement is for.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#768692;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="532" y="810" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;span style=&quot;font-size:12px&quot;&gt;The quality assurance statement, or your part of it.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1228" y="810" width="532" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="&lt;span style=&quot;font-size:12px;color:#007F3B&quot;&gt;The dashed line is the loop. What you report back is what the next piece of work avoids, which is what GovS 010 6.10 asks for: lessons captured through the cycle, evaluated, and acted on at the start of the next piece of work.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="912" width="1720" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;Open alongside, at any stop.&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;§2&lt;/b&gt; for what binds the work in front of you. &lt;b&gt;§5&lt;/b&gt; to check the level is right, because assuring to the wrong level is a finding in itself. &lt;b&gt;§12&lt;/b&gt; for the checklist and the log.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#0072C6;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="942" width="1720" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1036" width="1060" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;b style=&quot;font-size:13px;color:#003087&quot;&gt;Your own checks are the first line, not the last one&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="1050" width="1016" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;span style=&quot;font-size:12px&quot;&gt;Independence does not mean the analyst stops assuring their own work. It means there shall &lt;b&gt;also&lt;/b&gt; be formal independent assurance. There is no level at which nobody independent looks at the work, and no level at which the analyst is excused their own checks.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="62" y="1076" width="1016" height="98" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
