        <mxCell id="n54" value="&lt;span style=&quot;font-size:11px&quot;&gt;Grey: a subject that lives inside another section, and where to find it&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="78" y="1161" width="810" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;span style=&quot;font-size:12px&quot;&gt;§8 is the one section that gathers rather than adds. Being Business Critical changes what happens at seven points in the lifecycle, and each of those points belongs to the section that owns it, so §8 puts them in the order you meet them and &lt;b&gt;includes&lt;/b&gt; each passage from its owner rather than copying it. The two cannot drift apart. Every section named here is written out in the text description below the picture.&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="912" y="1036" width="848" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Producing Quality Analysis  ·  NHS Business Services Authority&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1208" width="1720" height="20" as="geometry" />
        </mxCell>
