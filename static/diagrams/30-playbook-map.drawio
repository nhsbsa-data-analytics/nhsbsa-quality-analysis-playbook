        <mxCell id="n42" value="&lt;b style=&quot;font-size:11px&quot;&gt;What a word means, and which GovS 010 clause a section answers to&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;Appendix A1 for the glossary, A2 for the mapping&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
