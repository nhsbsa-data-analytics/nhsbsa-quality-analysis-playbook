        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;Yellow: If this is you, two sections that apply to some work&lt;/span&gt;" style="html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
