        <mxCell id="n13" value="&lt;span style=&quot;font-size:12px;color:#231F20&quot;&gt;A tier is one band of activity, and a Level includes every level inside it.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
