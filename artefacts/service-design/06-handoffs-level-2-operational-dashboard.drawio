        <mxCell id="n35" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="546" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="Be named as the approver before the work starts, not found at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="546" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="546" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Sign the analysis off, and record your role, the date and what you confirmed in the project record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="546" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="546" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;What is handed over&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="631" width="1266" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;1.&lt;/b&gt; Commissioner &amp;#8594; Analyst, at &lt;b&gt;Engagement and scoping&lt;/b&gt;. The decision, the deadline and the quality expected&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="651" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;2.&lt;/b&gt; Analyst &amp;#8594; Critical friend, at &lt;b&gt;Design&lt;/b&gt;. The assurance plan, with the reviewer named on it&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="671" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;3.&lt;/b&gt; Critical friend &amp;#8594; Analyst, at &lt;b&gt;Analysis&lt;/b&gt;. Findings, which are the analyst's to act on&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="691" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;4.&lt;/b&gt; Analyst &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Draft results, so they are understood before sign-off&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="711" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;5.&lt;/b&gt; Analyst &amp;#8594; Your team lead, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. The output, the quality assurance statement and the project record&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="731" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;6.&lt;/b&gt; Your team lead &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Signed off by your team lead&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="751" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="789" width="1266" height="133" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;WHY THIS ONE IS LEVEL 2 ENHANCED&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="803" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;A monthly operational dashboard is impact 2 in NHSBSA's own worked examples, which the tool marks as still to be developed. Impact 2 reads Level 2 Enhanced at moderate and high likelihood, Level 1 Standard at low and Level 3 Comprehensive at very high, so score your own work rather than match it. What Level 2 adds over Level 1 is separation from the work: someone who had no hand in producing it reviews it, named before you start, because a reviewer found afterwards reviews what was produced while one named beforehand shapes it. Your team lead signs it off. The project record, the quality assurance log and the code are archived together and linked from the output. The statement is required but not published until Level 3. Because this one is a regular output it also goes to the review meeting NHSBSA holds every month, chaired by the Analytical Quality and Assurance Lead, which no standard asks for.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="827" width="1226" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="984" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
