        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Machine checks find roughly a third to a half of accessibility issues. They cannot judge whether alternative text is right, whether a heading describes what is under it, or whether a route makes sense to somebody using a screen reader. Passing them is necessary and is not sufficient, and the accessibility statement says so.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="627" width="1226" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="747" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
