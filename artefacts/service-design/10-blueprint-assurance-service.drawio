        </mxCell>
        <mxCell id="n42" value="Review the plan. Confirm the approach answers the question and the assurance planned is at the right level. Put your own time in the schedule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
