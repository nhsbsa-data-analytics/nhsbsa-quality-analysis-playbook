        <mxCell id="n40" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;Independent advice on this one assignment&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
