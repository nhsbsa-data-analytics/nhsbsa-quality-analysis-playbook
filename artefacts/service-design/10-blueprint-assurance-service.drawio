        </mxCell>
        <mxCell id="n43" value="Run the checks for the level. Reproduce the calculations from source at Level 2 and above. Report errors and improvements back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="602" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="Communicate the assurance state: appropriately scoped, executed, validated, verified and documented." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="602" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="What you reported back is what the next piece of work avoids." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="602" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="701" width="150" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Analysis Senior Responsible Officer&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="703" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;Business Critical work only&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="737" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="Named at scoping. Confirm the Business Critical status, the register entry, and that resources and plans are in place." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="701" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="Confirm design governance has been followed before the analysis starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="701" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="Stay aware of progress, and be available to approve at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="701" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="Review the assurance evidence, then approve as fit for its intended use. At Level 4 the Lead Assurer signs off first, then you." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="701" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="Revalidate the designation annually, and before any reuse for a new purpose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="701" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="" style="shape=line;direction=east;strokeColor=#231F20;strokeWidth=1.6;dashed=1;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="206" y="798.0" width="1100" height="10" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b style=&quot;font-size:11px;color:#231F20&quot;&gt;Line of internal interaction&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="788" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;Below it, roles that stand behind every piece of work rather than this one&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="212" y="806.0" width="1088" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="828" width="150" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Organisational roles and records&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;Who holds them is in the governance and management framework, not in this playbook&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="864" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="The Analytical Quality and Assurance Lead confirms levels and takes a level dispute. The Business Critical register holds the entry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="828" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="The governance and management framework names who holds each role, so a change of post holder is not a change to the guidance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="828" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="Information governance, before the work starts, where personal data is involved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="828" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="The Lead Official for Statistics is the route for whether an output is fit to publish." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="828" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="The senior officer accountable for analysis answers for the activity, not for any one output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="828" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="Any one impact&lt;br&gt;dimension at 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="937" width="168" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="Settled here, at scoping, by the commissioner and the analyst together. Yes makes the work Business Critical: Level 4, a register entry, and a named Analysis Senior Responsible Officer, all from this stage. No leaves the level the matrix gave it. Everything else on this blueprint applies either way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=12;spacingRight=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="414" y="937" width="892" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;The one branch&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="941" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1027" width="1266" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;HOW TO READ THIS&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1041" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;The three lines are the notation. The line of interaction separates what the commissioner does from what is done for them. The line of visibility separates work they see from work they do not. The line of internal interaction separates this piece of work from the roles that stand behind all of it.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1065" width="1226" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1185" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
