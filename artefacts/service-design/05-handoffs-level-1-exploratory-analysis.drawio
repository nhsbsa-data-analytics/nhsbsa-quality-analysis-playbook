          <mxGeometry x="872" y="518" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="518" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;What is handed over&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1266" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;1.&lt;/b&gt; Commissioner &amp;#8594; Analyst, at &lt;b&gt;Engagement and scoping&lt;/b&gt;. The decision, the deadline, and how certain the answer has to be&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="652" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;2.&lt;/b&gt; Analyst &amp;#8594; Critical friend, at &lt;b&gt;Analysis&lt;/b&gt;. The headline numbers, for a colleague to sense check&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;3.&lt;/b&gt; Critical friend &amp;#8594; Analyst, at &lt;b&gt;Analysis&lt;/b&gt;. What the sense check found, which is the analyst's to act on&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="692" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;4.&lt;/b&gt; Analyst &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Draft results first, with the main limitation and a short quality assurance statement&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="712" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1266" height="119" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;WHY THIS ONE IS LEVEL 1 STANDARD&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="764" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;The Decision row's level 1 is analysis where &quot;no decision, action, resource allocation, policy, service or performance assessment would be materially affected&quot;, which is exploratory, informative or for learning. The Reputation row's level 1 names exploratory analysis outright. Highest impact 1 low reads Level 1 at every likelihood but very high. Level 1 is the floor, and it is still not no assurance: it is separation within your team. A colleague sense checks the headline numbers, four sections of the project record are completed, realistically one side of A4, and a short statement is required. The record is stored with the output, and the statement is not published: publishing it with the output starts at Level 3.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="788" width="1226" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="931" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
