          <mxGeometry x="40" y="555" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="You are named at scoping and the register entry is made then, not once the work is designed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="519" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="Confirm design governance has been followed before the analysis starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="519" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Stay aware of progress, and be available to approve at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="519" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Review the evidence, then approve as fit for its intended use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="519" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="Revalidate the designation annually, and before any reuse for a new purpose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="519" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;What is handed over&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="604" width="1266" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;1.&lt;/b&gt; Commissioner &amp;#8594; Analyst, at &lt;b&gt;Engagement and scoping&lt;/b&gt;. The decision, the deadline, and how certain the answer has to be&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="624" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;2.&lt;/b&gt; Analyst &amp;#8594; Critical friend, at &lt;b&gt;Design&lt;/b&gt;. The design and plan, with the critical friend named on it&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="644" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;3.&lt;/b&gt; Critical friend &amp;#8594; Analyst, at &lt;b&gt;Analysis&lt;/b&gt;. Findings, which are the analyst's to act on&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="664" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;4.&lt;/b&gt; Analyst &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Draft results, so they are understood before sign-off&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="684" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;5.&lt;/b&gt; Analyst &amp;#8594; Analysis Senior Responsible Officer, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. The assurance evidence&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="704" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;6.&lt;/b&gt; Critical friend &amp;#8594; Analysis Senior Responsible Officer, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Lead Assurer sign-off, which comes first&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="724" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;7.&lt;/b&gt; Analysis Senior Responsible Officer &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Approved as fit for its intended use&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="744" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="782" width="1266" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;WHY THIS ONE IS LEVEL 4 BCA&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="796" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;One impact dimension at 4 settles it. The Finance row's level 4 is analysis that &quot;determines, or is relied on for, major funding, investment, commissioning, resource-allocation or policy decisions&quot;, which is what a funding allocation formula is. So the work is Business Critical and the level is 4, said at scoping and before the design. Four roles, and between them seven pages of this playbook. Level 4 adds formal audit and external review, and the work finishes published with its quality assurance statement, on the register, and the designation revalidated annually.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="1226" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="948" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
