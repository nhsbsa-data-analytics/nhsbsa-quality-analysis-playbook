          <mxGeometry x="650" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;4. Delivery&lt;br&gt;and sign-off&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
