        <mxCell id="n8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="150" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Evidence&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="178" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;What exists at the end of the stage&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Scope and specification. Assurance level decision sheet. A register entry, where the work is Business Critical." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="176" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="The approved design and plan, with the critical friend named on it. The quality assurance checklist for the level." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="176" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="The quality assurance log: what was checked, when, and what was found. The decision log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="176" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="The output, and the quality assurance statement. Published together at Level 3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="176" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="The review record and the lessons. A revalidated designation, for Level 3 and Level 4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF7;strokeColor=#007F3B;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="176" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="261" width="150" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Commissioner&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="263" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;The role the service is for&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="297" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="State the decision, the deadline, and how certain the answer has to be. Score the six impact dimensions with the analyst. Find the time the level needs, or narrow the question." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="261" width="212" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Approve the design before work proceeds, confirming it meets your need." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="261" width="212" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="Stay available. Review any change of design or method. Resist changing the question late." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="261" width="212" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="Confirm it meets your need, apply its limitations, and approve the results for release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="261" width="212" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="Above Level 1 the review is yours to own: with the analyst at Level 2, and with the Analysis Senior Responsible Officer at Level 3 and Level 4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6FA;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="261" width="212" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="" style="shape=line;direction=east;strokeColor=#231F20;strokeWidth=1.6;dashed=1;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="206" y="387.0" width="1100" height="10" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b style=&quot;font-size:11px;color:#231F20&quot;&gt;Line of interaction&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="377" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Above it, what the commissioner does. Below it, what is done for them&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="212" y="395.0" width="1088" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="417" width="150" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Analyst&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="419" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Visible to the commissioner&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="453" width="150" height="53" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="Clarify the real question and challenge a request that arrives framed as an output. Document the scope, the boundaries and the assumptions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="417" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="Choose the method and place it among the eight model types. Name the reviewer before the work starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="417" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="Do the work. Your own verification and validation first. Quantify the uncertainty and log decisions as you go." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="417" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="Write it up with the caveats in the output itself. Produce the quality assurance statement the level requires." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="417" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Record the lessons where the next analyst will look for them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="417" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="" style="shape=line;direction=east;strokeColor=#231F20;strokeWidth=1.6;dashed=1;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="206" y="528.0" width="1100" height="10" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="&lt;b style=&quot;font-size:11px;color:#231F20&quot;&gt;Line of visibility&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="518" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Below it, work the commissioner does not watch happen&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="212" y="536.0" width="1088" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="558" width="150" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Critical friend&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Independent advice on this one assignment&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="594" width="150" height="53" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="Understand the brief, the context and how critical the work is. You are named at design, not found at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="558" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="Review the plan. Confirm the approach answers the question and the assurance planned is at the right level. Put your own time in the schedule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="558" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="Run the checks for the level. Reproduce the calculations from source at Level 2 and above. Report errors and improvements back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="558" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="Communicate the assurance state: appropriately scoped, executed, validated, verified and documented." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="558" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="What you reported back is what the next piece of work avoids." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="558" width="212" height="91" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="657" width="150" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Analysis Senior Responsible Officer&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="659" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Business Critical work only&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="693" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="Named at scoping. Confirm the Business Critical status, the register entry, and that resources and plans are in place." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="657" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="Confirm design governance has been followed before the analysis starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="657" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="Stay aware of progress, and be available to approve at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="657" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="Review the assurance evidence, then approve as fit for its intended use. At Level 4 the Lead Assurer signs off first, then you." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="657" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="Revalidate the designation annually, and before any reuse for a new purpose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#C9D1D3;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="657" width="212" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="" style="shape=line;direction=east;strokeColor=#231F20;strokeWidth=1.6;dashed=1;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="206" y="754.0" width="1100" height="10" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b style=&quot;font-size:11px;color:#231F20&quot;&gt;Line of internal interaction&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="744" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Below it, roles that stand behind every piece of work rather than this one&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="212" y="762.0" width="1088" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="784" width="150" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Organisational roles and records&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Who holds them is in the governance and management framework, not in this playbook&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="The Analytical Quality and Assurance Lead confirms levels and takes a level dispute. The Business Critical register holds the entry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="784" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="The governance and management framework names who holds each role, so a change of post holder is not a change to the guidance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="784" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="Information governance, before the work starts, where personal data is involved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="784" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="The Head of Profession for Statistics is the route for whether an output is fit to publish." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="784" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="The senior officer accountable for analysis answers for the activity, not for any one output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="784" width="212" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="Any one impact&lt;br&gt;dimension at 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="893" width="168" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="Settled here, at scoping, by the commissioner and the analyst together. Yes makes the work Business Critical: Level 4, a register entry, and a named Analysis Senior Responsible Officer, all from this stage. No leaves the level the matrix gave it. Everything else on this blueprint applies either way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=12;spacingRight=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="414" y="893" width="892" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;The one branch&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="897" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="983" width="1266" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;HOW TO READ THIS&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="997" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;The three lines are the notation. The line of interaction separates what the commissioner does from what is done for them. The line of visibility separates work they see from work they do not. The line of internal interaction separates this piece of work from the roles that stand behind all of it.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1021" width="1226" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Kainos Software Limited, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1141" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
