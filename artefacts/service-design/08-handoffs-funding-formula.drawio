        <mxCell id="n1" value="&lt;b style=&quot;font-size:20px;color:#003087&quot;&gt;One piece of work, four roles&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1266" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px;color:#425563&quot;&gt;A funding allocation formula, which NHSBSA's decision sheet gives as an example of Level 4 Business Critical work. The route this playbook sets out for work of that kind, not a record of a particular piece of work.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1266" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;1. Engagement&lt;br&gt;and scoping&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;2. Design&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;3. Analysis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;4. Delivery&lt;br&gt;and sign-off&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b style=&quot;font-size:12px;color:#FFFFFF&quot;&gt;5. Review&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003087;strokeColor=#003087;fontColor=#231F20;fontFamily=Arial;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="118" width="212" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="150" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Commissioner&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="178" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Owns the question and the resource&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="150" height="68" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="State the decision, the deadline, and how certain the answer has to be. Score the level with the analyst, and find what Level 4 assurance needs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="176" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Approve the design before work proceeds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="176" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Stay available. Resist changing the question late." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="176" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Confirm it meets your need and apply its limitations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="176" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="The review is yours to own, with the Analysis Senior Responsible Officer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="176" width="172" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="150" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Analyst&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="292" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Owns the method and the write-up&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="326" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Clarify the real question. Record the scope, the boundaries and the assumptions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="290" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Choose the method, and place it among the eight model types." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="290" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="Do your own checks first. Log decisions as you go, and quantify the uncertainty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="290" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="Write it up, with the caveats in the output itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="290" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="Record the lessons where the next analyst will look." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="290" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="375" width="150" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Critical friend&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="377" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;At Level 4 BCA, a Lead Assurer from outside the delivering team, with external review as well&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="411" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;span style=&quot;color:#768692&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="375" width="172" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="You are named at design, not found at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="375" width="172" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="Reproduce the calculations from source. Examine the assumptions, and report what you find back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="375" width="172" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="Sign off as Lead Assurer, which comes before the approval below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="375" width="172" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="What you reported back is what the next piece of work avoids." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="375" width="172" height="93" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="476" width="150" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Analysis Senior Responsible Officer&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;Approves this one output as fit for its intended use&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="512" width="150" height="39" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="You are named at scoping and the register entry is made then, not once the work is designed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="476" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="Confirm design governance has been followed before the analysis starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="476" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Stay aware of progress, and be available to approve at delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="476" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Review the evidence, then approve as fit for its intended use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="476" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="Revalidate the designation annually, and before any reuse for a new purpose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="476" width="172" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;What is handed over&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="561" width="1266" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;1.&lt;/b&gt; Commissioner &amp;#8594; Analyst, at &lt;b&gt;Engagement and scoping&lt;/b&gt;. The decision, the deadline, and how certain the answer has to be&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="581" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;2.&lt;/b&gt; Analyst &amp;#8594; Critical friend, at &lt;b&gt;Design&lt;/b&gt;. The design and plan, with the critical friend named on it&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="601" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;3.&lt;/b&gt; Critical friend &amp;#8594; Analyst, at &lt;b&gt;Analysis&lt;/b&gt;. Findings, which are the analyst's to act on&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="621" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;4.&lt;/b&gt; Analyst &amp;#8594; Analysis Senior Responsible Officer, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. The assurance evidence&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="641" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;5.&lt;/b&gt; Critical friend &amp;#8594; Analysis Senior Responsible Officer, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Lead Assurer sign-off, which comes first&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="661" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#005EB8&quot;&gt;6.&lt;/b&gt; Analysis Senior Responsible Officer &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Approved as fit for its intended use&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="681" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="719" width="1266" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;WHY THIS ONE IS LEVEL 4 BCA&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="733" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;One dimension at 4 settles it. The Finance row's level 4 is analysis that &quot;determines, or is relied on for, major funding, investment, commissioning, resource-allocation or policy decisions&quot;, which is what a funding allocation formula is. So the work is Business Critical and the level is 4, said at scoping and before the design. Four jobs, and between them seven sections. Level 1 work asks a great deal less: one analyst, a colleague within the team, and deciding your assurance level.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="757" width="1226" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Kainos Software Limited, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="885" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
