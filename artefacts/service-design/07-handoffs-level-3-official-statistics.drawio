        <mxCell id="n36" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="561" width="172" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="561" width="172" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Sign the output off, and set the review date." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7F5;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="561" width="172" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="561" width="172" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;What is handed over&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="649" width="1266" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;1.&lt;/b&gt; Commissioner &amp;#8594; Analyst, at &lt;b&gt;Engagement and scoping&lt;/b&gt;. The decision, the deadline, and how certain the answer has to be&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="669" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;2.&lt;/b&gt; Analyst &amp;#8594; Critical friend, at &lt;b&gt;Design&lt;/b&gt;. The assurance plan, with the assurer from outside the team named on it&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="689" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;3.&lt;/b&gt; Critical friend &amp;#8594; Analyst, at &lt;b&gt;Analysis&lt;/b&gt;. Findings, which are the analyst's to act on&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="709" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;4.&lt;/b&gt; Analyst &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Draft results, so they are understood before sign-off&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="729" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;5.&lt;/b&gt; Analyst &amp;#8594; Lead Official for Statistics, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. The output, the published statement and the assurance evidence&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="749" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b style=&quot;color:#003087&quot;&gt;6.&lt;/b&gt; Lead Official for Statistics &amp;#8594; Commissioner, at &lt;b&gt;Delivery and sign-off&lt;/b&gt;. Signed off, for release with the statement&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="769" width="1266" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="807" width="1266" height="119" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;WHY THIS ONE IS LEVEL 3 COMPREHENSIVE&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="821" width="1226" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;NHSBSA's worked examples put an official statistics publication, such as Dental Statistics, at impact 3, alongside Principal Component Analysis, a Board report, an FOI response and a ministerial briefing. High visibility raises how much assurance the work needs, and on its own it does not make the analysis Business Critical, so there is no Analysis Senior Responsible Officer in this lane. Level 2 added separation from the work. Level 3 adds separation from the team, full verification and validation, code assured, uncertainty quantified where the method allows, and the statement published with the output. The Lead Official for Statistics signs it off, a review date is set, and review is annual.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="845" width="1226" height="77" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="988" width="1266" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
