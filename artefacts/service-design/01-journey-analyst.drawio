        </mxCell>
        <mxCell id="n30" value="Agree the decision, the question, what is out of scope, the deadline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
