          <mxGeometry x="40" y="369" width="150" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b style=&quot;font-size:12px;color:#003087&quot;&gt;Watch out for&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="371" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;What the playbook warns about here&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="150" height="29" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="&lt;span style=&quot;color:#768692&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="206" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="Challenging a brief is part of the job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="At scoping and not later. About five minutes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="The checks are cumulative. Name your reviewer before you start." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="No agreed margin of error means no threshold to test against." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="A checklist shows intent. A log shows it was done." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1316" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;span style=&quot;color:#768692&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1538" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="Ask information governance before the work starts, not at sign-off." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1760" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="At Level 1 the review is yours to own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1982" y="369" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="Any one impact&lt;br&gt;dimension at 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="802" y="450" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="Yes. The work is Business Critical. Business Critical analysis is the route in nine steps, and it brings Level 4 BCA, a register entry and a named Analysis Senior Responsible Officer, all starting at scoping. Everything else on this journey still applies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=top;dashed=0;spacingLeft=12;spacingRight=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="978" y="450" width="1090.0" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;The one branch&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="454" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="578" width="2154" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;AND ROUND AGAIN&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="592" width="2114" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Stop 9 loops back to stop 2. What you record at the end is what the next piece of work starts from.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="616" width="2114" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="&lt;span style=&quot;font-size:11px;color:#425563&quot;&gt;&lt;b&gt;Open alongside, at any stop.&lt;/b&gt; R8 for which standards bind this work. Roles and responsibilities for who owns a decision you are stuck on. R2 for the template. R3 for the person.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="2114" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="&lt;span style=&quot;font-size:10px;color:#768692&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Kainos Software Limited, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="704" width="2154" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
