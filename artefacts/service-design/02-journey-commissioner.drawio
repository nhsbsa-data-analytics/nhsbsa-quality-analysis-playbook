        </mxCell>
        <mxCell id="n46" value="Agreed at scoping rather than described afterwards." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="428" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="Where time or resource constrain the approach, understand the risks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;span style=&quot;color:#425563&quot;&gt;None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#EDEFF0;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="872" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="Under deadline pressure, narrow the question, not the level." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1094" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="You are accountable for its use and dissemination." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1316" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="Above Level 1 the review is yours, with the analyst." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DEDC;strokeColor=#DA291C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=9;spacingRight=9;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1538" y="379" width="212" height="67" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="Any one impact&lt;br&gt;dimension at 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFB81C;strokeColor=#B07C00;fontColor=#231F20;fontFamily=Arial;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="460" width="160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="Deciding whether the analysis is Business Critical is yours. Any one impact dimension at 4 makes it so. If you and the analyst cannot agree, it goes to the Analytical Quality and Assurance Lead." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#FFB81C;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;dashed=0;spacingLeft=12;spacingRight=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="756" y="460" width="868.0" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="&lt;b style=&quot;font-size:11px;color:#003087&quot;&gt;The one branch&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="464" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDEE;strokeColor=#005EB8;fontColor=#231F20;fontFamily=Arial;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;dashed=0;spacingLeft=8;spacingRight=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="588" width="1710" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="&lt;b style=&quot;font-size:11px;color:#003087;letter-spacing:0.4px&quot;&gt;AND ROUND AGAIN&lt;/b&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="602" width="1670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;Step 7 loops back to step 2. What review finds is what your next commission should start from.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="626" width="1670" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;span style=&quot;font-size:11px;color:#231F20&quot;&gt;&lt;b&gt;Open alongside, at any step.&lt;/b&gt; R7 for what quality assurance is buying you. Roles and responsibilities for what each of the four roles owns. Business Critical analysis if the answer to that question was yes.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="1670" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="&lt;span style=&quot;font-size:10px;color:#425563&quot;&gt;NHSBSA Producing Quality Analysis Playbook. Service design artefacts for workshop use. Seamus Sands for NHSBSA, SOW-DOC053.&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#231F20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="714" width="1710" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
